# Copy to .env and adjust. Infrastructure settings only (prefix PE_).
# Business settings (organisation, currency, timezone), users and roles are stored in MongoDB
# and are created through the first-run setup screen / POST /api/v1/setup.
PE_MONGO_URI=mongodb://localhost:27017
PE_DB_NAME=sales_order_promotions
PE_MONGO_MAX_POOL_SIZE=50
PE_MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
PE_JWT_SECRET=replace-with-a-long-random-secret
PE_JWT_EXPIRE_MINUTES=480
PE_CORS_ORIGINS=["http://localhost:5173"]

# Public URL of the React app; added to the CORS origins (comma-separate several). Local or ngrok, e.g.
#   FRONTEND_URL=https://yyyy.ngrok-free.app
FRONTEND_URL=http://localhost:5173
# Optional, for free ngrok URLs that change on every restart (instead of editing FRONTEND_URL each time):
# PE_CORS_ORIGIN_REGEX=^https://[a-z0-9-]+\.ngrok-free\.(app|dev)$
# Optional: only answer these Host headers ("*" = any). Example for local + ngrok:
# PE_TRUSTED_HOSTS=localhost,127.0.0.1,*.ngrok-free.app,*.ngrok-free.dev

